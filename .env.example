# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,debtclear.aryangorde.com

# Groq (the only AI provider)
# Comma-separated keys enable the multi-key failover pool. A single key works too.
GROQ_API_KEYS=your-groq-key-1,your-groq-key-2

# GROQ_MODEL is deliberately left unset. Leaving it out means the server follows
# api/groq_pool.py:DEFAULT_MODEL, so a model retirement is fixed by shipping code.
# Pinning it here is how a decommissioned model survived a deploy that was meant
# to replace it: the stale line kept overriding the new default. Set it only to
# deliberately override, and prefer the GROQ_MODEL repo variable (synced by
# deploy/remote_deploy.sh) so CI owns the value instead of a hand-edited file.
# GROQ_MODEL=openai/gpt-oss-120b
