# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,debtclear.aryangorde.com

# ── Amazon Bedrock (the only AI provider) ────────────────────────────────────
# A Bedrock long-term API key — create one in the Bedrock console under API keys.
# boto3 reads this automatically. If it is unset, the standard AWS credential
# chain (~/.aws, AWS_* env vars, or an instance role) is used instead.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Region the bedrock-runtime endpoint is called in. Defaults to eu-north-1.
BEDROCK_REGION=eu-north-1

# BEDROCK_MODEL is deliberately left unset — the server then follows
# api/bedrock_client.py:DEFAULT_MODEL, so a model retirement is fixed by shipping
# code rather than hand-editing this file. Pinning a model here is exactly how a
# decommissioned one once survived the deploy that was meant to replace it.
#
# NOTE: Nova Pro is NOT available In-Region from eu-north-1 — only through the EU
# geo inference profile. The default is therefore "eu.amazon.nova-pro-v1:0".
# From a US region use "us.amazon.nova-pro-v1:0". The bare "amazon.nova-pro-v1:0"
# works only where In-Region inference is offered (e.g. us-east-1, eu-west-2).
# BEDROCK_MODEL=eu.amazon.nova-pro-v1:0
